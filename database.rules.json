{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "tournaments": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$tournamentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
